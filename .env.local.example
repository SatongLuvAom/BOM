# Supabase
# Dashboard: Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Dashboard: Project Settings > API Keys > Publishable key
# This project keeps the historical ANON_KEY variable name, but the value can be the new Supabase publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Dashboard: Project Settings > API Keys > Secret keys
# Server-side only. Required for LINE material lookup after RLS is enabled.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Single owner access
# Only this authenticated Supabase user can access protected web pages and APIs.
OWNER_EMAIL=owner@example.com

# LINE Messaging API
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_BOT_API_BASE_URL=https://api.line.me

# AI price suggestion
# Optional. Required only for /api/boq/[id]/ai-price.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Receipt Import AI/OCR
# Server-side only. Required only for /api/receipts/[id]/extract.
GEMINI_API_KEY=your-gemini-api-key
